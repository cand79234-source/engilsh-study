# ===== English OS · Oracle Cloud Always Free 环境变量 =====
# 复制为 .env 后填写真实值：  cp .env.example .env
# .env 已被 .gitignore 忽略，不会进入代码仓库（密钥安全）。

# 【必填】Neon 连接串 —— 用与 Render 完全相同的那一条：
#   postgresql://neondb_owner:xxxx@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# 数据源是外部 Neon；迁移到 Oracle 不新建、不迁移数据库，只复用这个连接串。
# 警告：此值留空会导致应用回落到容器内 SQLite（数据会随容器重建丢失），务必填写。
DATABASE_URL=

# 【强烈建议】访问口令 —— 建议与 Render 上的 EOS_TOKEN 保持一致，用户无需记新口令。
# 不设则站点完全开放（任何拿到网址的人都能读写你的学习数据）。
EOS_TOKEN=

# 【可选】火山方舟 AI 批改（豆包/Doubao）。不填则 AI 批改回落本地规则，其它功能不受影响。
ARK_API_KEY=
ARK_MODEL=

# 【可选】应用时区，默认中国时间（库内按中国自然周统计），一般不用改。
APP_TZ=Asia/Shanghai

# 【可选】域名。填了（A 记录指向本机公网 IP）Caddy 自动签发 Let's Encrypt 证书走 HTTPS；
#         留空则仅 HTTP 监听 :80。
DOMAIN=
