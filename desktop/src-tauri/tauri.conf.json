{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "eos-float",
  "version": "1.0.0",
  "identifier": "com.eos.stealth.float",
  "build": {
    "beforeDevCommand": "echo dev",
    "devUrl": "https://engilsh-os.onrender.com/stealth",
    "beforeBuildCommand": "echo build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "stealth",
        "title": "",
        "url": "https://engilsh-os.onrender.com/stealth",
        "width": 380,
        "height": 640,
        "minWidth": 300,
        "minHeight": 420,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
